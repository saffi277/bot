{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test:ratelimit": "node scripts/verify-rate-limit.mjs",
    "test:auth": "node scripts/verify-telegram-auth.mjs",
    "test:ops": "node scripts/verify-operations.mjs",
    "test:intake": "node scripts/verify-bot-intake.mjs",
    "test": "npm run test:ratelimit && npm run test:auth && npm run test:ops && npm run test:intake",
    "quality": "node --env-file-if-exists=.env.local scripts/quality-report.mjs",
    "bakeoff": "node --env-file-if-exists=.env.local scripts/model-bakeoff.mjs",
    "bot:doctor": "node --env-file-if-exists=.env.local scripts/bot-doctor.mjs",
    "prompt": "node scripts/print-prompt.mjs",
    "models": "node --env-file-if-exists=.env.local scripts/list-models.mjs",
    "stats": "node --env-file-if-exists=.env.local scripts/stats.mjs",
    "bot:webhook": "node --env-file-if-exists=.env.local telegram-bot/register-webhook.mjs",
    "setup:env": "node scripts/setup-env.mjs",
    "channel": "node scripts/channel.mjs"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
