# ── Site ──────────────────────────────────────────────────────────────
# Public address, used by the Telegram bot's "open" button.
APP_URL=https://saffi277-bot-photo.koorymoe.chatgpt.site

# ── Restoration model ─────────────────────────────────────────────────
# Google AI Studio key. Without it the site runs but refuses to process.
GEMINI_API_KEY=
# Optional override; defaults to gemini-3.1-flash-image.
ENHANCE_MODEL=

# ── Cost controls ─────────────────────────────────────────────────────
# Longest edge of the output. Raising this raises the bill roughly with area.
MAX_OUTPUT_EDGE=2048
# Per visitor (by IP), per day.
LIMIT_GUEST_DAILY=2
# Per signed-in Telegram account, per day.
LIMIT_USER_DAILY=5
# Ceiling across ALL visitors per day. This is what fixes the monthly bill:
# 25/day x 30 x $0.067 is about $50/month. Raise only with the budget in mind.
DAILY_GLOBAL_CAP=25
# D1 binding name holding the counters. Processing is refused when absent.
D1_BINDING=DB

# ── Telegram ──────────────────────────────────────────────────────────
# Create the token with @BotFather. Keep the real value out of Git.
TELEGRAM_BOT_TOKEN=
# A random string used to verify that requests to /api/telegram came from Telegram.
TELEGRAM_WEBHOOK_SECRET=
